{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Mèo Xu",
  "mainBinaryName": "MeoXu",
  "version": "1.2.1",
  "identifier": "vn.meoxu.app",
  "build": {
    "frontendDist": "../web",
    "beforeDevCommand": { "script": "node scripts/stage.js", "cwd": "..", "wait": true },
    "beforeBuildCommand": { "script": "node scripts/stage.js", "cwd": ".." }
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": null,
      "capabilities": ["mx-local", "mx-remote"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Mèo Xu",
    "copyright": "Mèo Xu - game phi thương mại",
    "category": "Game",
    "shortDescription": "Mèo Xu - game nuôi mèo",
    "licenseFile": "license_vi.txt",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Vietnamese", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "nsis-hooks.nsh"
      }
    }
  }
}
